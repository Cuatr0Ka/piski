{
  "name": "piski-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Panel Piski: Estado actual y Pronóstico de creciente (demostración local con datos simulados).",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/inline-build.mjs",
    "verify:dist": "node scripts/verificar-entrega.mjs",
    "generar:escenarios": "node scripts/generar-escenarios.mjs",
    "generar:mapa": "node scripts/generar-mapa.mjs"
  },
  "dependencies": {
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
